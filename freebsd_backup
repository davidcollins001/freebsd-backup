#!/bin/sh

set -x

: ${BACKUP_DIRS:="/etc /usr/local/etc /var/db/pkg"}
: ${BACKUP_ROOT:="/var/freebsd-backup"}
: ${BACKUP_HISTORY_KEEP:="14d"}
: ${FULL_BACKUP_FREQ:="6d"}

if [ -e /usr/local/etc/freebsd_backup.conf ]; then
	. /usr/local/etc/freebsd_backup.conf
fi

mkdir -p "${BACKUP_ROOT}"

# run user defind `pre` function
if [ ! -z `command -v pre_backup_hook` ]; then
    pre_backup_hook
fi

# check for backup more recent that full backup freq
latest_full_backup=$(find ${BACKUP_ROOT} -iname "*full*" -type f \
    -mtime -${FULL_BACKUP_FREQ})

if [ -z "$latest_full_backup" ]; then
    full="full"

    backup_timestamp="$(date '+%Y%m%d-%H%M')"
    backup_file_name="freebsd-backup-${full}-${backup_timestamp}.tar.xz"
    backup_file_path="${BACKUP_ROOT}/${backup_file_name}"

    tar -cJf "${backup_file_path}" ${BACKUP_DIRS}
else
    full="diff"

    backup_timestamp="$(date '+%Y%m%d-%H%M')"
    backup_file_name="freebsd-backup-${full}-${backup_timestamp}.tar.xz"
    backup_file_path="${BACKUP_ROOT}/${backup_file_name}"

    latest_diff_backup=$(find ${BACKUP_ROOT} -iname "*diff*" -type f \
        -mtime -${FULL_BACKUP_FREQ})

    # not diff backups, backup everything since last full backu
    if [ -z "$latest_diff_backup" ]; then
        latest_backup=$latest_full_backup
    else
        latest_backup=$latest_diff_backup
    fi
    latest_backup=$(echo $latest_backup | sort -r | awk '{print $1}')

    # find files changed since last backup and add to tar
    files=$(find ${BACKUP_DIRS} -type f -newer $latest_backup 2>/dev/null)
    if [ ! -z "$files" ]; then
        find ${BACKUP_DIRS} -type f -newer $latest_backup -print0 | \
            tar --null -T - -cJf "${backup_file_path}"
    fi
fi

# run user defind `post` function
if [ ! -z `command -v post_backup_hook` ]; then
    post_backup_hook
fi

find ${BACKUP_ROOT} -name "freebsd-backup-*.tar.*" \
    -mtime +${BACKUP_HISTORY_KEEP} -delete
